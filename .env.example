# Public origin used for canonical URLs, Open Graph and sitemap.
# Required in production; defaults to https://aitechx.vn when unset.
# On GitHub Pages the deploy workflow sets this from actions/configure-pages,
# unless you override it with a repository variable named SITE_URL.
NEXT_PUBLIC_SITE_URL=https://aitechx.vn

# Path prefix applied when the site is served from a subdirectory, e.g. a GitHub
# Pages project site at https://<owner>.github.io/<repo>/. Leave unset when the
# site is served from a domain root.
# PAGES_BASE_PATH=/aitechx-front

# Optional: where the contact form should POST submissions when you add a backend.
# Until then the form falls back to opening the visitor's mail client.
# CONTACT_FORM_ENDPOINT=
